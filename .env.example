##################  web  ##################

# NEXT_PUBLIC_ 접두사 : Next.js 빌드 시점에 클라이언트 js 번들에 포함되어서 브라우저에 노출(사용가능). 서버에서도 접근가능. 개발자도구에도 노출
# NEXT_PUBLIC 이 아닌 것 : Next.js 서버사이드에서만 접근 가능. 브라우저에서 확인 불가

# 브라우저에 사용하고 노출되어도 되는 값 : NEXT_PUBLIC 붙여도 됨
# 브라우저에 사용 안 하는 값 : 안 붙이는게 나음

# Next 서버에만 제공 
# 1. 내부 통신용 (Next.js SSR -> Spring Boot)
API_SERVER_URL=

# Next 클라,서버 둘 다 제공 (클라용)
# 2. 외부 통신용 (브라우저 -> Spring Boot)
NEXT_PUBLIC_API_SERVER_URL=
PORT=3000

##################  ai-advisor  ##################

# AI Service
GOOGLE_API_KEY=

# Service
AI_ADVISOR_PORT=
AI_SERVICE_LOG_LEVEL=

# Rate Limiting
MAX_ANALYSES_PER_USER_PER_MONTH=
CACHE_TTL_HOURS=
